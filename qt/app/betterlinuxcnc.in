#!/usr/bin/env python3
"""Installed PySide6/QML desktop entry point."""
import os
import sys

sys.path.insert(0, "@CMAKE_INSTALL_FULL_LIBDIR@/betterlinuxcnc/python")
os.environ.setdefault("BETTERCNC_QML_DIR", "@CMAKE_INSTALL_FULL_DATADIR@/betterlinuxcnc/qml")

from bettercnc.desktop import main

raise SystemExit(main())
